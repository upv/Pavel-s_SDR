# =============================================================================
# Config Files
# =============================================================================

SYSTEM_CONFIG="../common/sys_config.yaml"
GNB_CONFIG="../common/gnb.sa.band78.24prbs.2x2.conf"

CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps
CUDA_MPS_LOG_DIRECTORY=/tmp/nvidia-log

# =============================================================================
# Image Tags
# =============================================================================

GNB_IMAGE=oai-gnb-cuda-txrx
GNB_TAG=latest
UE_IMAGE=oai-nr-ue-antsdr
UE_TAG=latest
AMF_TAG=v2.1.10
SMF_TAG=v2.1.10
UPF_TAG=v2.1.10
TRFGEN_TAG=latest
FLEXRIC_TAG=latest

# =============================================================================
# gNB Extra Options
# =============================================================================

# note that this is platform specific
GNB_THREAD_POOL="--thread-pool ${SRK_THREAD_POOL:-6,7,8,9,10,11}"

#GNB_EXTRA_OPTIONS="--loader.ldpc.shlibversion _cuda"

# --- Tutorials (activate by loading the library) ---
# CUDA LDPC
#GNB_EXTRA_OPTIONS="--loader.ldpc.shlibversion _cuda"

# Demapper
#GNB_EXTRA_OPTIONS="--loader.demapper.shlibversion _orig"
#GNB_EXTRA_OPTIONS="--loader.demapper.shlibversion _capture"
#GNB_EXTRA_OPTIONS="--loader.demapper.shlibversion _trt --MACRLCs.[0].dl_max_mcs 10 --MACRLCs.[0].ul_max_mcs 10"

# Neural Receiver
# works best with 24 PRBs
#GNB_EXTRA_OPTIONS="--loader.receiver.shlibversion _trt --MACRLCs.[0].ul_max_mcs 10"

# Link Adaptation (see plugins/link_adaptation/doc/)
#GNB_EXTRA_OPTIONS="--loader.link_adaptation.shlibversion _log"                    # OAI-LA + CSV stats
#GNB_EXTRA_OPTIONS="--loader.link_adaptation.shlibversion _olla"                   # Simple OLLA (scheduling-stats-based)
#GNB_EXTRA_OPTIONS="--loader.link_adaptation.shlibversion _mcs_hist_log"           # OAI-LA + HARQ history + CSV
#GNB_EXTRA_OPTIONS="--loader.link_adaptation.shlibversion _mcs_hist_olla"          # Advanced OLLA + HARQ history (recommended)

# Channel Emulation (choose one CIR source: cir_file or cir_zmq)
# Option 1: File-based CIR (loads pre-computed CIR data from folder)
#GNB_EXTRA_OPTIONS="--cir-folder /opt/oai-gnb/plugins/channel_emulation/data/pass_through_cir"
# Option 2: ZMQ-based CIR (receives CIR data via ZMQ at runtime, use with SionnaRT GUI)
#GNB_EXTRA_OPTIONS="--cir-zmq-num-taps 48"

# MPS active thread percentage (only relevant when running the SionnaRT GUI)
#MPS_ACTIVE_THREAD_PCT=30.0

# =============================================================================
# UE Extra Options (soft-UE only)
# =============================================================================
#UE_EXTRA_OPTIONS="-C 3319680000 -r 24 --numerology 1 --ssb 516 --thread-pool ${SRK_UE_THREAD_POOL:-3,4}"

# --- PRB configs (uncomment one to replace UE_EXTRA_OPTIONS above) ---
UE_EXTRA_OPTIONS="-C 3604800000 -r 24 --numerology 1 --ssb 24 --thread-pool ${SRK_UE_THREAD_POOL:-3,4}"
#UE_EXTRA_OPTIONS="-C 3309480000 -r 51 --numerology 1 --ssb 238 --thread-pool ${SRK_UE_THREAD_POOL:-3,4}"
#UE_EXTRA_OPTIONS="-C 3319680000 -r 106 --numerology 1 --ssb 516 --thread-pool ${SRK_UE_THREAD_POOL:-3,4}"

# =============================================================================
# B200/USRP Hardware Configuration
# =============================================================================

USE_B2XX=yes
USRP_SERIAL=<U220_SERIAL>
# USRP_SERIAL_UE=<your_ue_serial>

# =============================================================================
# RF Options
# =============================================================================

# add -E for three quarter sampling with 106 PRBs
GNB_RF_OPTIONS="--RUs.[0].sdr_addrs serial=${USRP_SERIAL} --continuous-tx"
UE_RX_ANTENNA=TX/RX
GNB_RX_ANTENNA=TX/RX
# 2 x 15.36 MSps sc16 does not fit 1 GbE: sc8 RX / sc12 TX on the wire (E316 rejects sc12 RX)
UE_RX_OTW=sc8
UE_TX_OTW=sc12
UE_RF_OPTIONS="--usrp-args addr=192.168.1.10,recv_buff_size=50000000,send_buff_size=50000000 --initial-fo -37500 --ue-fo-compensation --band 78 --ue-nb-ant-rx 2 --ue-nb-ant-tx 2"
