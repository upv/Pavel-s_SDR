{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "MPLBACKEND": "macosx"
            }
        },
        {
            "name": "E310 TX",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tx_e310.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "MPLBACKEND": "macosx"
            }
        },
        {
            "name": "E310 RX",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/rx_e310.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "MPLBACKEND": "macosx"
            }
        },
        {
            "name": "Python: transmit_zhadoff",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/transmit_zhadoff.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
